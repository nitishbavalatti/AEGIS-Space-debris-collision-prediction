# ─── AEGIS Environment Variables ──────────────────────────────────────────
# Copy this file to .env and fill in your credentials

# CesiumJS Ion Token (https://ion.cesium.com → Access Tokens → Create Token)
# Free account gives you a default token — paste it here
VITE_CESIUM_TOKEN="YOUR_CESIUM_TOKEN_HERE"

# Space-Track.org (https://www.space-track.org/auth/createAccount)
SPACETRACK_USERNAME="YOUR_SPACETRACK_USERNAME_HERE"
SPACETRACK_PASSWORD="YOUR_SPACETRACK_PASSWORD_HERE"

# N2YO API (https://www.n2yo.com/api/)
N2YO_API_KEY=

# NASA APIs — no key needed for DONKI, but register at https://api.nasa.gov
NASA_API_KEY="YOUR_NASA_API_KEY_HERE"

# MongoDB (local by default, change for Atlas)
MONGO_URI=mongodb://localhost:27017/aegis

# Flask
FLASK_SECRET_KEY=aegis-secret-change-in-prod
FLASK_ENV=development

# ─── HARDWARE (fill in when ESP32 is connected) ───────────────────────────────
# Set USE_MOCK_SENSOR=true until hardware arrives
USE_MOCK_SENSOR=False
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_TOPIC=aegis/sensors

# Bengaluru coordinates (ground station location)
STATION_LAT="YOUR_STATION_LATITUDE_HERE"
STATION_LON="YOUR_STATION_LONGITUDE_HERE"
STATION_ALT="YOUR_STATION_ALTITUDE_HERE"

MQTT_BROKER=127.0.0.1