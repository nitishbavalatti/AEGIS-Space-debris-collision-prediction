# ─── AEGIS Frontend Environment Variables ─────────────────────────────────
# Copy this file to .env and fill in your credentials
# IMPORTANT: All frontend env vars must start with VITE_ to work in Vite

# CesiumJS Ion Token
# 1. Go to https://ion.cesium.com
# 2. Sign up for a free account
# 3. Go to Access Tokens → your default token is already there
# 4. Paste it below
VITE_CESIUM_TOKEN="YOUR_CESIUM_TOKEN_HERE"
